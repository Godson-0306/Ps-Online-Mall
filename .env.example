# Frontend (baked in at build time)
VITE_API_URL=http://localhost:4000/api

# API
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173

# Postgres — leave empty to use the local JSON store
DATABASE_URL=
DATABASE_SSL=false

# Payments (optional — demo checkout works without this)
PAYSTACK_SECRET_KEY=

# Image uploads (optional — local /uploads is used without this)
CLOUDINARY_URL=
